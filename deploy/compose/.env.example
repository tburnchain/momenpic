# Compose interpolation variables for deploy/compose/docker-compose.yml.
# cp .env.example .env && chmod 600 .env   — generate every password with `openssl rand -hex 24`
# (hex keeps them URL-safe: they are embedded in ACVM_DATABASE_URL / ACVM_REDIS_URL / ACVM_CLICKHOUSE_URL).
# Application settings (ACVM_*) do NOT go here — they live in env/acvm.env (template: /.env.example).

# ── release ──────────────────────────────────────────────────────────────────
ACVM_REGISTRY=ghcr.io/tburn-labs
ACVM_VERSION=1.0.0
ACVM_ENV=prod
# vault in prod; `env` only for the dev override (ACVM_SECRET__* variables)
ACVM_SECRET_BACKEND=vault

# ── public hostnames (Cloudflare) ───────────────────────────────────────────
# link hub: the only public origin (/hub/*, /r/*, /media/*) — NOT behind Access
ACVM_HUB_HOST=go.example.com
# console + /api/v1 and Grafana — both behind Cloudflare Access (SSO)
ACVM_CONSOLE_HOST=console.example.com
ACVM_GRAFANA_HOST=grafana.example.com

# ── Cloudflare Tunnel + Access ──────────────────────────────────────────────
# `cloudflared tunnel create acvm` → UUID; credentials JSON → secrets/cloudflared-credentials.json
CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
# Zero Trust team: <team>.cloudflareaccess.com
CF_ACCESS_TEAM_NAME=example
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# Access application AUD tags (Zero Trust → Access → Applications → Overview)
CF_ACCESS_CONSOLE_AUD=
CF_ACCESS_GRAFANA_AUD=
GRAFANA_ADMIN_EMAIL=owner@example.com
GRAFANA_JWT_ENABLED=true

# ── infrastructure credentials ──────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
ACVM_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
GRAFANA_DB_PASSWORD=
MONITOR_DB_PASSWORD=
REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
# break-glass local admin; day-to-day login is SSO via Access JWT
GRAFANA_ADMIN_PASSWORD=

# ── build ───────────────────────────────────────────────────────────────────
# sha256 of the wal-g release tarball (deploy/postgres/Dockerfile verifies it)
WALG_SHA256=

# ── networks (change only if they collide with host routes; keep Vault bound CIDRs in sync) ──
ACVM_BACKEND_SUBNET=172.30.10.0/24
ACVM_EGRESS_SUBNET=172.30.20.0/24
ACVM_EDGE_SUBNET=172.30.30.0/24
ACVM_OPS_SUBNET=172.30.40.0/24

# ── image versions (pin; bump deliberately) ─────────────────────────────────
ACVM_POSTGRES_TAG=16-walg
REDIS_VERSION=7.4-alpine
CLICKHOUSE_VERSION=25.8
TEMPORAL_VERSION=1.28.1
TEMPORAL_UI_VERSION=2.40.1
VAULT_VERSION=1.20.4
OTELCOL_VERSION=0.135.0
PROMETHEUS_VERSION=v3.5.0
ALERTMANAGER_VERSION=v0.28.1
PUSHGATEWAY_VERSION=v1.11.1
GRAFANA_VERSION=12.2.0
LOKI_VERSION=3.5.5
PROMTAIL_VERSION=3.5.5
NODE_EXPORTER_VERSION=v1.9.1
POSTGRES_EXPORTER_VERSION=v0.17.1
REDIS_EXPORTER_VERSION=v1.74.0
CLOUDFLARED_VERSION=2025.9.1
