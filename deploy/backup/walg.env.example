# WAL-G → Cloudflare R2 (S3 API). Copy to deploy/compose/env/walg.env, chmod 600. Loaded by the postgres
# container (archive_command / backup-push / wal-fetch) and sourced by deploy/backup/{backup,restore}.sh
# (ClickHouse + Vault backups reuse the same bucket under other prefixes).
#
# §10 백업: PostgreSQL daily full + continuous WAL → RPO 15 min (archive_timeout=300 s), RTO 2 h.
# Use a dedicated R2 API token scoped to this bucket only (Object Read & Write), and an R2 lifecycle rule:
#   clickhouse/  → delete after 30 days      ops/vault/ → delete after 90 days
#   (basebackups_005/ and wal_005/ are pruned by `wal-g delete retain FULL 14`, see backup.sh)

WALG_ENABLED=true
WALG_S3_PREFIX=s3://acvm-backups/postgres
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>

# client-side encryption before upload (32 bytes hex: `openssl rand -hex 32`). Losing it = losing backups:
# store a copy offline with the Vault unseal keys.
WALG_LIBSODIUM_KEY=<64-hex-chars>
WALG_LIBSODIUM_KEY_TRANSFORM=hex

WALG_COMPRESSION_METHOD=zstd
WALG_DELTA_MAX_STEPS=0
WALG_UPLOAD_CONCURRENCY=4
WALG_DOWNLOAD_CONCURRENCY=8
WALG_PREVENT_WAL_OVERWRITE=true

# local socket connection used by backup-push (runs as the postgres OS user inside the container)
PGHOST=/var/run/postgresql
PGUSER=postgres
PGDATABASE=postgres

# retention for `wal-g delete retain FULL n` (daily fulls → n days of point-in-time recovery)
ACVM_BACKUP_RETAIN_FULL=14
# ClickHouse BACKUP ... TO S3() destination (same bucket, different prefix)
ACVM_CLICKHOUSE_BACKUP_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com/acvm-backups/clickhouse
