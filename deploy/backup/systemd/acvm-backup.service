# Install: sudo cp deploy/backup/systemd/acvm-backup.* /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now acvm-backup.timer acvm-restore-drill.timer
# Assumes the repo is checked out at /opt/acvm (adjust WorkingDirectory/ExecStart otherwise).
[Unit]
Description=ACVM daily backups (PostgreSQL full via WAL-G, ClickHouse, Vault) to Cloudflare R2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/acvm
ExecStart=/opt/acvm/deploy/backup/backup.sh all
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
