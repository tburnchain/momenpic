    {
      "type": "table",
      "title": "arm 사후분포 (상위 50, 관측 EPC 순)",
      "description": "CTR ~ Beta(α, β), 주문·수수료 ~ Gamma(shape, rate) — 평균 = shape / rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acvm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acvm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT arm_key, trials, round((ctr_alpha / NULLIF(ctr_alpha + ctr_beta, 0))::numeric, 5) AS ctr_post_mean, round((order_shape / NULLIF(order_rate, 0))::numeric, 4) AS order_post_mean, round((comm_shape / NULLIF(comm_rate, 0))::numeric, 1) AS commission_post_mean, round((commission_krw / NULLIF(clicks, 0))::numeric, 1) AS epc_observed_krw, impressions, clicks, orders, commission_krw, retired, updated_at FROM arm_posterior ORDER BY epc_observed_krw DESC NULLS LAST LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
