    {
      "type": "table",
      "title": "꼬리 콘텐츠 (48h, 조회 상위 2 %)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "acvm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "acvm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "WITH latest AS (SELECT publication_id, any(content_id) AS content_id, any(platform) AS platform, argMax(value, (ts, version)) AS views, min(ts) AS first_seen FROM acvm.perf_event WHERE metric = 'views' AND ts >= now() - INTERVAL 7 DAY GROUP BY publication_id) SELECT platform, content_id, publication_id, views, first_seen FROM latest WHERE first_seen >= now() - INTERVAL 48 HOUR AND views >= (SELECT quantileExact(0.98)(views) FROM latest) ORDER BY views DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
