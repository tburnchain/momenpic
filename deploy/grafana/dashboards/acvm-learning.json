    {
      "type": "timeseries",
      "title": "탐색 비중 (추정) vs 목표 20 %",
      "description": "trials < 30인 arm(퇴출 판정 전)에 대한 관측 비중 — 현재 trials 기준 근사치",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acvm-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acvm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', o.observed_at) AS time, avg(CASE WHEN p.trials < 30 THEN 1.0 ELSE 0.0 END) AS explore_share, 0.20 AS target FROM arm_observation o JOIN arm_posterior p ON p.workspace_id = o.workspace_id AND p.arm_key = o.arm_key WHERE $__timeFilter(o.observed_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
