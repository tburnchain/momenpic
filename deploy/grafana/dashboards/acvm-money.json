    {
      "type": "table",
      "title": "플랫폼별 중앙값 조회수 ÷ I*",
      "description": "≥ 1 이면 콘텐츠를 늘릴수록 이익이 선형 이상 증가 (§2.3). 계정 단위는 콘솔 리포트 참조.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "acvm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "acvm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT platform, count() AS publications, quantileExact(0.5)(views) AS median_views, round(median_views / ${istar}, 2) AS median_over_istar FROM ( SELECT platform, publication_id, argMax(value, (ts, version)) AS views FROM acvm.perf_event WHERE metric = 'views' AND $__timeFilter(ts) GROUP BY platform, publication_id) GROUP BY platform ORDER BY median_over_istar DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "table",
      "title": "플랫폼별 수수료 (기간)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "acvm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "acvm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT pl.platform AS platform, sum(r.gmv_krw) AS gmv_krw, sum(r.commission_krw) AS commission_krw, sum(r.cancelled_krw) AS cancelled_krw, sum(r.clicks) AS clicks, sum(r.orders) AS orders, round(sum(r.commission_krw) / greatest(sum(r.clicks), 1), 1) AS epc_krw FROM (SELECT * FROM acvm.affiliate_report FINAL WHERE $__dateFilter(date)) AS r INNER JOIN (SELECT sub_id, platform FROM acvm.publication_link FINAL) AS pl ON pl.sub_id = r.sub_id GROUP BY platform ORDER BY commission_krw DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
