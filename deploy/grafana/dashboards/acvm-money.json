          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT platform, sub_id, content_id, views, report_clicks, orders, gmv_krw, commission_krw, cancelled_krw, net_commission_krw, round(epc_krw, 1) AS epc_krw FROM acvm.content_roi ORDER BY net_commission_krw DESC LIMIT 25"
        }
      ],
