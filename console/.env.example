# ACVM operations console — copy to .env.local for `npm run dev`.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time
# (for Docker pass them as --build-arg, see Dockerfile).

# Base URL of the ACVM API (FastAPI, /api/v1). The API must allow this console's origin
# in ACVM_CONSOLE_ORIGINS (default: http://localhost:3000).
NEXT_PUBLIC_ACVM_API=http://localhost:8000/api/v1

# 1 = serve realistic fixture data from src/mocks (no backend needed; state lives in the tab).
NEXT_PUBLIC_ACVM_MOCK=0
