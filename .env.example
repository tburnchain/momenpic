# ACVM application settings — every ACVM_* variable read by acvm.config.Settings (env prefix ACVM_, nested "__").
#
#   local dev (uv run …):   cp .env.example .env            (pydantic-settings reads ./.env)
#   compose dev (make up):  same ./.env is loaded by deploy/compose/docker-compose.dev.yml
#   production:             cp .env.example deploy/compose/env/acvm.env && chmod 600 deploy/compose/env/acvm.env
#
# Uncommented lines are the values you normally set; commented lines show the design default (§ references are to
# the design document) — uncomment only to change them. NO REAL SECRETS IN THIS FILE: secrets are references
# (*_REF) resolved through Vault in prod (ACVM_SECURITY__SECRET_BACKEND=vault) or ACVM_SECRET__<REF> in dev.
# In compose, database/redis/clickhouse/temporal/otel/vault endpoints are injected by docker-compose.yml and override
# whatever is written here.

# ─────────────────────────── runtime ───────────────────────────
# dev | test | staging | prod   (prod refuses to boot with dev shortcuts: see Settings.assert_production_safe)
ACVM_ENV=dev
# ACVM_TIMEZONE=Asia/Seoul
# ACVM_DATA_DIR=var

# ─────────────────────────── data stores ───────────────────────────
# PostgreSQL 16 + pgvector in prod (asyncpg driver); SQLite for local dev/tests
ACVM_DATABASE_URL=sqlite+aiosqlite:///./var/acvm.db
# ACVM_DATABASE_URL=postgresql+asyncpg://acvm:<password>@localhost:5432/acvm
# Redis 7: token buckets, locks, Redis Streams event bus (unset → in-memory, single process)
# ACVM_REDIS_URL=redis://:<password>@localhost:6379/0
# ClickHouse: perf_event / affiliate_report (unset → SQL fallback perf store)
# ACVM_CLICKHOUSE_URL=http://acvm:<password>@localhost:8123/acvm

# ─────────────────────────── orchestration (§5) ───────────────────────────
# local = in-process DAG runner; temporal = durable workflows
ACVM_ORCHESTRATOR=local
# ACVM_TEMPORAL_HOST=localhost:7233
# ACVM_TEMPORAL_NAMESPACE=acvm
# queue routing (§10 least privilege) — every process needs all three names; a worker serves the roles whose
# queue equals its --queue. Single-node dev: set all three to the same name and run one worker.
#   main    CommandWorkflow + bookkeeping (no ffmpeg, no social tokens)
#   render  produce_product: script · FFmpeg render · gate · links (render image)
#   publish PublishWorkflow + publish activity (the only Vault acvm-publisher role)
# ACVM_TEMPORAL_TASK_QUEUE=acvm-main
# ACVM_TEMPORAL_RENDER_QUEUE=acvm-render
# ACVM_TEMPORAL_PUBLISH_QUEUE=acvm-publish
# ACVM_WORKSPACE_DAILY_BUDGET_KRW=20000.0
# ACVM_AUTO_APPROVE_ACCOUNT_AGE_DAYS=14

# ─────────────────────────── public URLs ───────────────────────────
# link hub origin (public through the Cloudflare tunnel: /hub/{handle}, /r/{code})
ACVM_LINK_HUB_BASE_URL=http://localhost:8000
# CORS origins for the operations console (JSON list); prod: ["https://console.example.com"]
# ACVM_CONSOLE_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# OTLP/HTTP collector, e.g. http://otel-collector:4318 (unset → tracing off)
# ACVM_OTEL_ENDPOINT=

# ─────────────────────────── §2.5 economics (replace with measured values) ───────────────────────────
# ACVM_ECONOMICS__C_UNIT_SHORT_KRW=150.0
# ACVM_ECONOMICS__C_UNIT_TEXT_KRW=30.0
# ACVM_ECONOMICS__CTR=0.008
# ACVM_ECONOMICS__CVR=0.03
# ACVM_ECONOMICS__AOV_KRW=30000.0
# ACVM_ECONOMICS__COMMISSION_RATE=0.03
# ACVM_ECONOMICS__LOGNORMAL_SIGMA=2.0

# ─────────────────────────── §9.4 unit costs (KRW, contract prices) ───────────────────────────
# ACVM_COSTS__LLM_PER_SCORE_KRW=2.0
# ACVM_COSTS__LLM_PER_SCRIPT_KRW=30.0
# ACVM_COSTS__LLM_PER_CRITIC_KRW=18.0
# ACVM_COSTS__TTS_PER_30S_KRW=50.0
# ACVM_COSTS__RENDER_PER_SHORT_KRW=0.0
# ACVM_COSTS__STORAGE_PER_SHORT_KRW=2.0

# ─────────────────────────── §7 quota (per account per day; 2–30 % of API limits) ───────────────────────────
# JSON objects for dict settings
# ACVM_QUOTA__DAILY_CAP={"threads": 20, "instagram": 5, "youtube": 3, "tiktok": 3, "facebook": 3, "kakao": 10}
# ACVM_QUOTA__API_LIMIT_24H={"threads": 250, "instagram": 100, "youtube": 100, "tiktok": 15, "facebook": 30, "kakao": 10000}
# ACVM_QUOTA__MAX_API_FRACTION=0.30
# ACVM_QUOTA__JITTER_MINUTES=7
# ACVM_QUOTA__AVOID_TOP_OF_HOUR_MINUTES=3
# ACVM_QUOTA__MIN_GAP_MINUTES=20
# ACVM_QUOTA__WINDOW_START_HOUR=9
# ACVM_QUOTA__WINDOW_END_HOUR=23
# ACVM_QUOTA__COOLDOWN_HOURS=48
# ACVM_QUOTA__FAILURE_RATE_THRESHOLD=0.10
# ACVM_QUOTA__FAILURE_CONFIDENCE=0.80
# ACVM_QUOTA__REACH_DROP_THRESHOLD=-0.60

# ─────────────────────────── §8 M7 gate (the optimizer can never relax these) ───────────────────────────
# ACVM_GATE__RULE_SET_VERSION=v1
# disclosure texts are legal copy (§8.1) — change only with legal review
# ACVM_GATE__STANDARD_DISCLOSURE=이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
# ACVM_GATE__VIDEO_DISCLOSURE=광고 · 쿠팡 파트너스 활동으로 수수료를 받습니다
# ACVM_GATE__DISCLOSURE_OVERLAY_SECONDS=3.0
# ACVM_GATE__REFERENCE_COSINE_MAX=0.80
# ACVM_GATE__REFERENCE_NGRAM_MAX=0.15
# ACVM_GATE__REFERENCE_NGRAM_N=5
# ACVM_GATE__ACCOUNT_MINHASH_MAX=0.60
# ACVM_GATE__ACCOUNT_LOOKBACK_DAYS=30
# ACVM_GATE__NEW_ACCOUNT_HOLD_DAYS=14
# ACVM_GATE__NEW_TEMPLATE_HOLD_COUNT=10
# ACVM_GATE__MAX_FIX_ITERATIONS=3
# ACVM_GATE__PRICE_FRESH_MINUTES=360

# ─────────────────────────── §4 M10 optimizer ───────────────────────────
# ACVM_OPTIMIZER__EXPLORATION_BUDGET=0.20
# ACVM_OPTIMIZER__REWARD_HORIZON_DAYS=7
# ACVM_OPTIMIZER__AMPLIFY_WINDOW_HOURS=48
# ACVM_OPTIMIZER__AMPLIFY_PERCENTILE=0.98
# ACVM_OPTIMIZER__AMPLIFY_VARIANTS=5
# ACVM_OPTIMIZER__RETIRE_MIN_TRIALS=30
# ACVM_OPTIMIZER__RETIRE_PERCENTILE=0.10
# ACVM_OPTIMIZER__PRIOR_STRENGTH=20.0

# ─────────────────────────── §4 M6 render ───────────────────────────
# ACVM_RENDER__WIDTH=1080
# ACVM_RENDER__HEIGHT=1920
# ACVM_RENDER__FPS=30
# ACVM_RENDER__TARGET_LUFS=-14.0
# ACVM_RENDER__TRUE_PEAK=-1.5
# Shorts are 20–25 s product pitches delivered fast: narration slower than MIN_SPEECH_SPS (Korean syllables/s)
# is sped up to TARGET_SPEECH_SPS; a voice that needs more than MAX_TEMPO is refused.
# ACVM_RENDER__MIN_SECONDS=20.0
# ACVM_RENDER__MAX_SECONDS=25.0
# ACVM_RENDER__MIN_SPEECH_SPS=7.5
# ACVM_RENDER__TARGET_SPEECH_SPS=8.0
# ACVM_RENDER__MAX_TEMPO=1.35
# ACVM_RENDER__CONCURRENCY=8
# ACVM_RENDER__FONT_FAMILY=Noto Sans CJK KR
# ACVM_RENDER__FONT_FILE=
# the render image sets these to /usr/bin/ffmpeg and /usr/bin/ffprobe
# ACVM_RENDER__FFMPEG=ffmpeg
# ACVM_RENDER__FFPROBE=ffprobe
# ACVM_RENDER__YAP1000_PATH=

# ─────────────────────────── Coupang Partners (§7) ───────────────────────────
# sandbox=true → fixture-backed client; must be false (and partner_id set) for ACVM_ENV=prod
ACVM_COUPANG__SANDBOX=true
# AF####### — used to verify every deeplink's partner ID right before publishing (§10)
ACVM_COUPANG__PARTNER_ID=
# ACVM_COUPANG__BASE_URL=https://api-gateway.coupang.com
# Vault refs (mount acvm): acvm/data/coupang {access_key, secret_key}
# ACVM_COUPANG__ACCESS_KEY_REF=coupang/access_key
# ACVM_COUPANG__SECRET_KEY_REF=coupang/secret_key
# ACVM_COUPANG__SEARCH_CALLS_PER_HOUR=8
# bestcategories + goldbox share one bucket
# ACVM_COUPANG__CATALOG_CALLS_PER_HOUR=8
# ACVM_COUPANG__DEEPLINK_CALLS_PER_MINUTE=30
# ACVM_COUPANG__REPORT_CALLS_PER_HOUR=30
# ACVM_COUPANG__CACHE_TTL_SECONDS=21600
# ACVM_COUPANG__BREAKER_OPEN_SECONDS=3600

# ─────────────────────────── LLM (Anthropic) ───────────────────────────
# auto (default) = Claude as soon as a key exists — secret ref anthropic/api_key (console › 운영 준비 › 비밀값,
#   switches without restart) or ANTHROPIC_API_KEY env — otherwise the deterministic grounded generator;
# anthropic = always Claude (boot warns if no key); offline = never call an LLM (tests, air-gapped)
ACVM_LLM__BACKEND=auto  # auto | anthropic | gemini | offline
# ACVM_LLM__MODEL_LARGE=claude-opus-5-5
# ACVM_LLM__MODEL_MEDIUM=claude-sonnet-5-5
# ACVM_LLM__MODEL_SMALL=claude-haiku-4-5
# ACVM_LLM__SERVER_FALLBACKS=true
# ACVM_LLM__MAX_RETRIES=3
# ACVM_LLM__TIMEOUT_SECONDS=120.0

# ─────────────────────────── AI integrations (콘솔 › 운영 준비 › AI 연동) ───────────────────────────
# Keys are registered in the console (stored in the secret store, verified live, switched on without a restart).
# LLM: auto = Claude when its key exists, Gemini when only Gemini exists, both → Claude first + Gemini on outages.
# ACVM_GEMINI__KEY_REF=gemini/api_key
# ACVM_GEMINI__BASE_URL=https://generativelanguage.googleapis.com/v1beta
# ACVM_GEMINI__MODEL_LARGE=gemini-3.8-flash
# ACVM_GEMINI__MODEL_MEDIUM=gemini-3.8-flash
# ACVM_GEMINI__MODEL_SMALL=gemini-3.5-flash-lite
# ACVM_GEMINI__TIMEOUT_SECONDS=120.0
# ACVM_GEMINI__MAX_RETRIES=2
# ACVM_GEMINI__INPUT_KRW_PER_MTOK=700.0
# ACVM_GEMINI__OUTPUT_KRW_PER_MTOK=4200.0
# GPT Image: scene backgrounds for non-product beats only (never the product).
# ACVM_OPENAI_IMAGE__KEY_REF=openai/api_key
# ACVM_OPENAI_IMAGE__BASE_URL=https://api.openai.com/v1
# ACVM_OPENAI_IMAGE__MODEL=gpt-image-2.5-flare
# ACVM_OPENAI_IMAGE__SIZE=1024x1536
# ACVM_OPENAI_IMAGE__QUALITY=medium
# ACVM_OPENAI_IMAGE__TIMEOUT_SECONDS=180.0
# ACVM_OPENAI_IMAGE__COST_PER_IMAGE_KRW=90.0
# Higgsfield: animates AI scene stills only (Authorization: Key <id>:<secret>).
# ACVM_HIGGSFIELD__KEY_ID_REF=higgsfield/key_id
# ACVM_HIGGSFIELD__KEY_SECRET_REF=higgsfield/key_secret
# ACVM_HIGGSFIELD__BASE_URL=https://api.higgsfield.ai
# ACVM_HIGGSFIELD__I2V_MODEL=kling-video/v2.5-turbo/standard/image-to-video
# ACVM_HIGGSFIELD__CLIP_SECONDS=5
# ACVM_HIGGSFIELD__CFG_SCALE=0.5
# ACVM_HIGGSFIELD__POLL_TIMEOUT_SECONDS=480.0
# ACVM_HIGGSFIELD__TIMEOUT_SECONDS=60.0
# ACVM_HIGGSFIELD__COST_PER_CLIP_KRW=450.0
# ElevenLabs: key in the secret store (elevenlabs/api_key); fast catalog voices are mapped automatically.
# ACVM_ELEVENLABS__MODEL_ID=eleven_multilingual_v2
# ACVM_ELEVENLABS__AUTO_VOICE_MAP=true
# ACVM_ELEVENLABS__KRW_PER_1K_CHARS=300.0
# AI scene media per short (scene beats only) and the on-screen label (AI 기본법 표시).
# ACVM_AI_VISUALS__MAX_IMAGES_PER_CONTENT=2
# ACVM_AI_VISUALS__MAX_CLIPS_PER_CONTENT=2
# ACVM_AI_VISUALS__ANIMATE_SCENES=true
# ACVM_AI_VISUALS__LABEL_TEXT=AI 생성 장면

# ─────────────────────────── embeddings ───────────────────────────
# hashing = local deterministic; voyage = Voyage AI (ref voyage/api_key)
# ACVM_EMBEDDINGS__BACKEND=hashing
# ACVM_EMBEDDINGS__MODEL=voyage-3.5
# ACVM_EMBEDDINGS__DIM=1024
# ACVM_EMBEDDINGS__API_KEY_REF=voyage/api_key

# ─────────────────────────── object storage (Cloudflare R2, §9.1) ───────────────────────────
# local = files under ACVM_OBJECTS__LOCAL_ROOT served at /media; s3 = R2 with 2-hour signed URLs
ACVM_OBJECTS__BACKEND=local
# ACVM_OBJECTS__LOCAL_ROOT=var/objects
# ACVM_OBJECTS__ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# ACVM_OBJECTS__BUCKET=acvm-media
# ACVM_OBJECTS__PUBLIC_BASE_URL=http://localhost:8000/media
# ACVM_OBJECTS__ACCESS_KEY_REF=r2/access_key
# ACVM_OBJECTS__SECRET_KEY_REF=r2/secret_key
# ACVM_OBJECTS__SIGNED_URL_TTL_SECONDS=7200

# ─────────────────────────── platforms (M8) ───────────────────────────
# dry_run=true → adapters record instead of calling (until G0/G1 sign-off)
ACVM_PLATFORMS__DRY_RUN=true
# TikTok public posting stays off until the app passes TikTok's audit (§7)
# ACVM_PLATFORMS__TIKTOK_AUDITED=false
# ACVM_PLATFORMS__GRAPH_VERSION=v24.0
# ACVM_PLATFORMS__THREADS_BASE=https://graph.threads.net/v1.0
# ACVM_PLATFORMS__GRAPH_BASE=https://graph.facebook.com
# ACVM_PLATFORMS__RUPLOAD_BASE=https://rupload.facebook.com
# ACVM_PLATFORMS__YOUTUBE_UPLOAD_BASE=https://www.googleapis.com/upload/youtube/v3
# ACVM_PLATFORMS__YOUTUBE_BASE=https://www.googleapis.com/youtube/v3
# ACVM_PLATFORMS__TIKTOK_BASE=https://open.tiktokapis.com

# ─────────────────────────── security (§10) ───────────────────────────
# env (dev: ACVM_SECRET__* below) | vault (prod: AppRole + KV v2 mount "acvm")
ACVM_SECURITY__SECRET_BACKEND=env  # env | file (single host: <data_dir>/secrets.json) | vault (prod)
# dev (bearer ACVM_SECURITY__DEV_API_TOKEN) | cloudflare_access (validates Cf-Access-Jwt-Assertion)
ACVM_SECURITY__AUTH_MODE=dev  # dev (token) | session (member login: e-mail + password) | cloudflare_access
# ACVM_SECURITY__SIGNUP_MODE=approval  # approval (owner activates new members) | open | closed
# ACVM_SECURITY__SESSION_COOKIE=acvm_session
# ACVM_SECURITY__SESSION_TTL_HOURS=336
# ACVM_SECURITY__LOGIN_MAX_FAILURES=5
# ACVM_SECURITY__LOGIN_LOCK_MINUTES=15
# ACVM_SECURITY__LOGIN_IP_LIMIT_PER_10MIN=30
# ACVM_SECURITY__SERVICE_TOKEN=  # optional script token in session mode (empty = disabled)
# ACVM_SECURITY__CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# ACVM_SECURITY__CF_ACCESS_AUDIENCE=<access application AUD tag>
# dev-mode only; rejected when ACVM_ENV=prod
# ACVM_SECURITY__DEV_API_TOKEN=dev-owner-token
# ACVM_SECURITY__VAULT_ADDR=http://127.0.0.1:8200
# ACVM_SECURITY__VAULT_MOUNT=acvm
# names of the env vars holding the AppRole credentials (values come from env/approle-<role>.env)
# ACVM_SECURITY__VAULT_ROLE_ID_ENV=ACVM_VAULT_ROLE_ID
# ACVM_SECURITY__VAULT_SECRET_ID_ENV=ACVM_VAULT_SECRET_ID
# ACVM_SECURITY__SECRET_CACHE_TTL_SECONDS=300
# ACVM_SECURITY__LINK_SIGNING_KEY_REF=acvm/link_signing_key
# ACVM_SECURITY__CLICK_IP_SALT_REF=acvm/click_ip_salt
# ACVM_SECURITY__AUDIT_RETENTION_DAYS=365

# ─────────────────────────── dev-only secret values (ACVM_SECURITY__SECRET_BACKEND=env) ───────────────────────────
# ref "a/b" → ACVM_SECRET__A__B. Placeholders only — real values live in Vault (docs/DEPLOY.md 4단계).
# These are read from the process environment (not by pydantic): compose env_file exports them; for bare
# `uv run` export them first (`set -a; . ./.env; set +a` — the Makefile does this).
ACVM_SECRET__ACVM__LINK_SIGNING_KEY=dev-link-signing-key-change-me
ACVM_SECRET__ACVM__CLICK_IP_SALT=dev-click-ip-salt
# ACVM_SECRET__COUPANG__ACCESS_KEY=
# ACVM_SECRET__COUPANG__SECRET_KEY=
# ACVM_SECRET__R2__ACCESS_KEY=
# ACVM_SECRET__R2__SECRET_KEY=
# ACVM_SECRET__VOYAGE__API_KEY=
# ACVM_SECRET__ANTHROPIC__API_KEY=
# ACVM_SECRET__GEMINI__API_KEY=
# ACVM_SECRET__OPENAI__API_KEY=
# ACVM_SECRET__HIGGSFIELD__KEY_ID=
# ACVM_SECRET__HIGGSFIELD__KEY_SECRET=
# ACVM_SECRET__ELEVENLABS__API_KEY=
# social tokens: channel_account.token_ref "tokens/<platform>/<handle>" → ACVM_SECRET__TOKENS__<PLATFORM>__<HANDLE>

# ─────────────────────────── Vault AppRole (prod; set per role in deploy/compose/env/approle-*.env) ───────────────────────────
# ACVM_VAULT_ROLE_ID=
# ACVM_VAULT_SECRET_ID=
